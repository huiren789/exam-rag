# 复制本文件为 .env，并填入你自己的密钥（硅基流动免费注册可得）
# 注意：.env 已被 .gitignore 忽略，不会被提交到 GitHub
SILICONFLOW_API_KEY=sk-在这里填你的密钥

# 可选：换成任意 OpenAI 兼容接口
# EXAMRAG_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
# EXAMRAG_MODEL=Qwen/Qwen3-8B

# 可选：换成你自己的资料文件（相对路径以仓库根为基准）
# EXAMRAG_MATERIAL=data/material.txt

# 可选：向量检索配置（需先 pip install -e ".[vector]"；dry-run 模式用离线桩，无需这两项）
# embedding 模型名，默认 BAAI/bge-small-zh-v1.5，可换任意 sentence-transformers 支持的中文模型
# EXAMRAG_VECTOR_MODEL=BAAI/bge-small-zh-v1.5
# 向量缓存文件路径（相对路径以仓库根为基准），默认 .cache/vectors.json，缓存不入 git
# EXAMRAG_VECTOR_CACHE=.cache/vectors.json
